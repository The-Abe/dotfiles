/* Master Config 1080p*/

/* ---- Configuration ---- */

configuration {
  font: "Terminess Nerd Font 9";
  modi: "drun,run,filebrowser,combi";
  show-icons: true;
  display-drun: "Apps";
  display-run: "Run";
  display-filebrowser: "Files";
  display-window: "Windows";
  drun-display-format: "{name}";
  //hover-select: true;
  me-select-entry: "MouseSecondary";
  me-accept-entry: "MousePrimary";
  //window-format: "{w} · {c} · {t}";
  dpi: 1;
  color-normal:   "#1d2021, #d5c4a1, #282828, #83a598, #1d2021";
  color-urgent:   "#1d2021, #fb4934, #282828, #fb4934, #1d2021";
  color-active:   "#1d2021, #b8bb26, #282828, #b8bb26, #1d2021";
  color-window:   "#1d2021, #d5c4a1, #504945";
  matching: "fuzzy";
  sort: true;
  case-sensitive: false;
}

* {
  background-color: transparent;
  text-color: #d5c4a1;
  spacing: 8px;
}

window {
  background-color: #1d2021;
  border: 1px;
  border-color: #504945;
  padding: 14px;
}

mainbox {
  background-color: #1d2021;
  padding: 0;
}

inputbar {
  background-color: #282828;
  border: 1px;
  border-color: #3c3836;
  padding: 13px 16px;
  spacing: 10px;
}

prompt {
  text-color: #fe8019;
}

entry {
  text-color: #fbf1c7;
  placeholder-color: #a89984;
}

listview {
  background-color: transparent;
  border: 0;
  padding: 6px 0px 2px 0px;
  spacing: 4px;
}

element {
  background-color: transparent;
  padding: 9px 12px;
  spacing: 12px;
}

element normal.normal {
  background-color: #1d2021;
  text-color: #d5c4a1;
}

element selected.normal {
  background-color: #504945;
  text-color: #fbf1c7;
}

element selected.active {
  background-color: #504945;
  text-color: #fabd2f;
}

element selected.urgent {
  background-color: #504945;
  text-color: #fb4934;
}

element-icon {
  size: 24px;
}

element-text {
  text-color: inherit;
}

scrollbar {
  background-color: transparent;
  handle-color: #504945;
  handle-width: 4px;
  width: 4px;
}

button {
  background-color: transparent;
  padding: 8px 12px;
  text-color: #a89984;
}

button selected {
  background-color: #504945;
  text-color: #fabd2f;
}
