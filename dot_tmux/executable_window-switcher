#!/usr/bin/env bash

# Popups run under a non-interactive shell, so ~/.zshrc's `mise activate`
# never runs and the mise shims stay on PATH (each call costs ~0.5s).
# Prepend the real tool dirs so tmux/fzf resolve to the actual binaries.
for _d in "$HOME"/.local/share/mise/installs/*/latest; do
    if [[ -d $_d ]]; then
        PATH="$_d:$PATH"
    fi
done
export PATH

set -euo pipefail

if ! command -v fzf >/dev/null 2>&1; then
    printf 'window-switcher: fzf is required\n' >&2
    exit 1
fi

windows=$(tmux list-windows -a -F '#S|#I|#{?@claude,#{@claude} ,}#W' 2>/dev/null || true)
if [[ -z $windows ]]; then
    exit 0
fi

selected=$(printf '%s\n' "$windows" | fzf \
    --height=100% \
    --layout=reverse \
    --border \
    --prompt='Window> ')

if [[ -n $selected ]]; then
    IFS='|' read -r session window _ <<< "$selected"
    target="=${session}:$window"

    if [[ -n ${TMUX:-} ]]; then
        tmux switch-client -t "$target"
    else
        tmux attach-session -t "$target"
    fi
fi
