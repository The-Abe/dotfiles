#!/usr/bin/env bash

# Popups run under a non-interactive shell, so ~/.zshrc's `mise activate`
# never runs and the mise shims stay on PATH (each call costs ~0.5s).
# Prepend the real tool dirs so tmux/fzf resolve to the actual binaries.
for _d in "$HOME"/.local/share/mise/installs/*/latest; do
    if [[ -d $_d ]]; then
        PATH="$_d:$PATH"
    fi
done
export PATH

if [[ $# -eq 1 ]]; then
    selected=$1
else
    # Search specified project directories (adjust paths to match your layout)
    selected=$(find ~/projects ~/.config -mindepth 1 -maxdepth 2 -type d | fzf)
fi

if [[ -z $selected ]]; then
    exit 0
fi

# Generate session name: replace '.' and ':' with '_' for tmux safety.
# Keep in sync with auto_tmux_projects in ~/.zshrc (config- prefix for ~/.config).
selected_name=$(basename "$selected" | tr '.:' '__')
if [[ $selected == "$HOME/.config/"* ]]; then
    selected_name="config-$selected_name"
fi
tmux_running=$(pgrep tmux)

# If outside tmux, start or attach
if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux new-session -s "$selected_name" -c "$selected"
    exit 0
fi

# If session doesn't exist, create it detached
if ! tmux has-session -t="$selected_name" 2>/dev/null; then
    tmux new-session -ds "$selected_name" -c "$selected"
fi

# Switch to the session
if [[ -z $TMUX ]]; then
    tmux attach-session -t "$selected_name"
else
    tmux switch-client -t "$selected_name"
fi
